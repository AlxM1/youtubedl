# YouTubeDL Service Configuration

# Download directory (files are stored here)
DOWNLOAD_DIR=/app/downloads

# Database connection string
DATABASE_URL=sqlite+aiosqlite:////app/data/vidgrab.db

# Maximum concurrent downloads
MAX_CONCURRENT_DOWNLOADS=3

# Server binding
HOST=0.0.0.0
PORT=8000

# API Key (REQUIRED for production deployments)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to disable auth (local-only use)
API_KEY=

# Rate limiting
EXTRACT_RATE_LIMIT=10          # Max format-extract requests per IP per minute
DOWNLOAD_RATE_LIMIT=20         # Max download requests per IP per minute (applied automatically)

# Disk space management
MIN_FREE_DISK_MB=500           # Minimum free disk space (MB) before refusing downloads

# Optional: Cookie file for authenticated content
# (private Instagram posts, age-restricted YouTube videos, etc.)
COOKIES_FILE=

# Cortex integration (task reporting)
# Default: http://cortex:3011
# The service will auto-detect and disable reporting if Cortex is unreachable
CORTEX_URL=http://cortex:3011
CORTEX_TIMEOUT=5
